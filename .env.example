# Copy to .env.local and fill in. Never commit .env.local.

VONAGE_API_KEY=
VONAGE_API_SECRET=

# Sender shown on the handset. Try an alphanumeric ID first; if North Macedonia
# rejects it, fall back to the Vonage-assigned trial number (digits only, no +).
SMS_SENDER=Ticket

# Comma-separated E.164 numbers that may be texted. Nothing else is ever sent to.
ALLOWED_NUMBERS=+38975560524

# Shared secret required by the form, so a stranger who finds the URL can't burn your credit.
APP_PIN=

# Set to 1 to return the composed message without calling Vonage (free testing).
DRY_RUN=
