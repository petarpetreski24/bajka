# Copy to .env.local and fill in. Never commit .env.local.

# Which provider to use: plivo (default) or vonage.
SMS_PROVIDER=plivo

# Plivo — Auth ID and Auth Token from the dashboard home.
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=

# Vonage — only needed if SMS_PROVIDER=vonage.
VONAGE_API_KEY=
VONAGE_API_SECRET=

# Sender shown on the handset. For Plivo this is the phone number you bought, digits only,
# no plus sign. Trial accounts cannot use alphanumeric sender IDs.
SMS_SENDER=

# Comma-separated E.164 numbers that may be texted. Nothing else is ever sent to.
ALLOWED_NUMBERS=+38975560524

# Optional. When set, the page must be opened as https://your-app.vercel.app/?k=THIS_VALUE
# so a stranger who finds the bare URL can't burn your credit. Leave empty to disable.
APP_PIN=

# Set to 1 to return the composed message without calling Vonage (free testing).
DRY_RUN=
